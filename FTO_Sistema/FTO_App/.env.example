# Modelo de configuracao — copie para .env e preencha os dados reais.
# O .env na pasta FTO_App e incluido automaticamente no build/publish.

EMPRESA_NOME=
EMPRESA_SUBTITULO=
EMPRESA_ENDERECO=
EMPRESA_CIDADE=
EMPRESA_TELEFONE=
EMPRESA_CNPJ=
EMPRESA_IE=
CUPOM_TITULO=
CUPOM_RODAPE=

# Opcional: só necessário se o repositório GitHub for PRIVADO.
# Crie um Personal Access Token (classic) com permissão "repo" / leitura de releases.
# FTO_UPDATE_TOKEN=ghp_seu_token_aqui
