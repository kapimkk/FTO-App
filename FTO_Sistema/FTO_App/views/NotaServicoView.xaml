<UserControl x:Class="FTO_App.Views.NotaServicoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PrimaryColor}" Padding="15,10">
            <TextBlock Text="🛠️ NFS-e (Padrão Nacional)" Foreground="White" FontSize="18" FontWeight="Bold"/>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" Padding="10" Margin="10,10,10,0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="TxtBusca" Width="240" Style="{StaticResource ModernTextBox}"
                         ToolTip="Buscar tomador ou número" TextChanged="TxtBusca_TextChanged"/>
                <ComboBox x:Name="CbFiltroStatus" Width="130" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="Filtro_Changed">
                    <ComboBoxItem Content="Todos status"/>
                    <ComboBoxItem Content="Rascunho" Tag="Rascunho"/>
                    <ComboBoxItem Content="Emitida" Tag="Emitida"/>
                    <ComboBoxItem Content="Rejeitada" Tag="Rejeitada"/>
                    <ComboBoxItem Content="Cancelada" Tag="Cancelada"/>
                </ComboBox>
                <Button Content="🔍 Filtrar" Style="{StaticResource ToolbarButtonStyle}" Margin="8,0,0,0" Click="BtnFiltrar_Click"/>
                <Button Content="+ Nova NFS-e" Style="{StaticResource HoverButtonStyle}" Width="120" Margin="8,0,0,0" Click="BtnNovo_Click"/>
                <Button Content="✏️ Editar" Style="{StaticResource ToolbarButtonStyle}" Margin="8,0,0,0" Click="BtnEditar_Click"/>
                <Button Content="🚀 Emitir NFS-e" Style="{StaticResource HoverButtonStyle}" Margin="8,0,0,0" Click="BtnAcoes_Click"
                        ToolTip="Abrir janela de emissão, XML, DANFSE e cancelamento"/>
                <Button Content="🗑️ Excluir" Background="{DynamicResource ActionDelBg}" Foreground="{DynamicResource ActionDelFg}"
                        BorderThickness="0" Padding="10,5" Margin="8,0,0,0" Click="BtnExcluir_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="10" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0" x:Name="GridNotas" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" MouseDoubleClick="Grid_MouseDoubleClick"
                          Background="{DynamicResource CardBackgroundBrush}" BorderThickness="0" RowHeight="26">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nº DPS" Binding="{Binding NumeroExibicao}" Width="80"/>
                        <DataGridTextColumn Header="Competência" Binding="{Binding DataCompetenciaFormatada}" Width="100"/>
                        <DataGridTextColumn Header="Tomador" Binding="{Binding TomadorNome}" Width="*"/>
                        <DataGridTextColumn Header="Serviço" Binding="{Binding DescricaoServico}" Width="180"/>
                        <DataGridTextColumn Header="Valor" Binding="{Binding ValorFormatado}" Width="100"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Chave" Binding="{Binding ChaveAcesso}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="1" Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content=" Anterior " Click="BtnPrev_Click"
                                Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                        <TextBlock x:Name="LblPageInfo" Text="Pág 1/1" VerticalAlignment="Center" Margin="10,0"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <Button Content=" Próxima " Click="BtnNext_Click"
                                Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="FormOverlay" Grid.RowSpan="3" Background="#99000000" Visibility="Collapsed" Panel.ZIndex="200">
            <Border Background="{DynamicResource CardBackgroundBrush}" Margin="30,20" CornerRadius="8" Padding="16"
                    MaxWidth="920" VerticalAlignment="Center" MaxHeight="700">
                <Border.Effect><DropShadowEffect BlurRadius="24"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,10">
                        <TextBlock x:Name="LblFormTitulo" Text="Cadastrar NFS-e" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TitleBrush}"/>
                        <Button DockPanel.Dock="Right" Content="✕" Width="32" Height="28" Click="BtnFecharForm_Click"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Identificação da DPS" FontWeight="Bold" Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <StackPanel Width="220" Margin="0,0,10,8">
                                    <TextBlock Text="Ambiente SEFIN *"/>
                                    <ComboBox x:Name="CbAmbiente" SelectedIndex="0"
                                              ToolTip="Produção restrita (sandbox da API) exige tpAmb=2. Só use Produção (1) se a Fiscal.NFSe.API estiver com AmbienteRestrito=false.">
                                        <ComboBoxItem Content="2 — Homologação (produção restrita)" Tag="2"/>
                                        <ComboBoxItem Content="1 — Produção nacional" Tag="1"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Width="100" Margin="0,0,10,8"><TextBlock Text="Série *"/><TextBox x:Name="TxtSerie" Style="{StaticResource ModernTextBox}"/></StackPanel>
                                <StackPanel Width="120" Margin="0,0,10,8"><TextBlock Text="Nº DPS *"/><TextBox x:Name="TxtNumeroDps" Style="{StaticResource ModernTextBox}"/></StackPanel>
                                <StackPanel Width="140" Margin="0,0,10,8"><TextBlock Text="Competência *"/><DatePicker x:Name="DpCompetencia"/></StackPanel>
                                <StackPanel Width="140" Margin="0,0,10,8"><TextBlock Text="IBGE emissão *"/><TextBox x:Name="TxtIbgeEmissao" Style="{StaticResource ModernTextBox}" ToolTip="cLocEmi — 7 dígitos"/></StackPanel>
                            </WrapPanel>

                            <TextBlock Text="Tomador *" FontWeight="Bold" Foreground="{DynamicResource TitleBrush}" Margin="0,8,0,8"/>
                            <WrapPanel>
                                <StackPanel Width="320" Margin="0,0,10,8">
                                    <TextBlock Text="Cliente cadastrado"/>
                                    <ComboBox x:Name="CbCliente" DisplayMemberPath="Nome" SelectionChanged="CbCliente_Changed"/>
                                </StackPanel>
                                <StackPanel Width="280" Margin="0,0,10,8"><TextBlock Text="Nome / Razão social *"/><TextBox x:Name="TxtTomadorNome" Style="{StaticResource ModernTextBox}"/></StackPanel>
                                <StackPanel Width="180" Margin="0,0,10,8"><TextBlock Text="CPF/CNPJ *"/><TextBox x:Name="TxtTomadorDoc" Style="{StaticResource ModernTextBox}"/></StackPanel>
                                <StackPanel Width="200" Margin="0,0,10,8"><TextBlock Text="E-mail"/><TextBox x:Name="TxtTomadorEmail" Style="{StaticResource ModernTextBox}"/></StackPanel>
                                <StackPanel Width="140" Margin="0,0,10,8"><TextBlock Text="Telefone"/><TextBox x:Name="TxtTomadorFone" Style="{StaticResource ModernTextBox}"/></StackPanel>
                                <StackPanel Width="280" Margin="0,0,10,8"><TextBlock Text="Logradouro"/><TextBox x:Name="TxtTomadorLgr" Style="{StaticResource ModernTextBox}"/></StackPanel>
                                <StackPanel Width="80" Margin="0,0,10,8"><TextBlock Text="Nº"/><TextBox x:Name="TxtTomadorNro" Style="{StaticResource ModernTextBox}"/></StackPanel>
                                <StackPanel Width="160" Margin="0,0,10,8"><TextBlock Text="Bairro"/><TextBox x:Name="TxtTomadorBairro" Style="{StaticResource ModernTextBox}"/></StackPanel>
                                <StackPanel Width="160" Margin="0,0,10,8"><TextBlock Text="Município"/><TextBox x:Name="TxtTomadorMun" Style="{StaticResource ModernTextBox}"/></StackPanel>
                                <StackPanel Width="60" Margin="0,0,10,8"><TextBlock Text="UF"/><TextBox x:Name="TxtTomadorUf" Style="{StaticResource ModernTextBox}" MaxLength="2"/></StackPanel>
                                <StackPanel Width="100" Margin="0,0,10,8">
                                    <TextBlock Text="CEP"/>
                                    <TextBox x:Name="TxtTomadorCep" Style="{StaticResource ModernTextBox}"
                                             KeyDown="TxtTomadorCep_KeyDown"
                                             ToolTip="Pressione Enter para buscar o endereço (ViaCEP)"/>
                                </StackPanel>
                                <StackPanel Width="120" Margin="0,0,10,8"><TextBlock Text="IBGE tomador"/><TextBox x:Name="TxtTomadorIbge" Style="{StaticResource ModernTextBox}"/></StackPanel>
                            </WrapPanel>

                            <TextBlock Text="Serviço *" FontWeight="Bold" Foreground="{DynamicResource TitleBrush}" Margin="0,8,0,8"/>
                            <WrapPanel>
                                <StackPanel Width="140" Margin="0,0,10,8"><TextBlock Text="cTribNac (6 díg.) *"/><TextBox x:Name="TxtCodTribNac" Style="{StaticResource ModernTextBox}" ToolTip="Lista Nacional — ex.: 010101"/></StackPanel>
                                <StackPanel Width="140" Margin="0,0,10,8"><TextBlock Text="cTribMun"/><TextBox x:Name="TxtCodTribMun" Style="{StaticResource ModernTextBox}"/></StackPanel>
                                <StackPanel Width="140" Margin="0,0,10,8"><TextBlock Text="IBGE prestação *"/><TextBox x:Name="TxtIbgePrestacao" Style="{StaticResource ModernTextBox}"/></StackPanel>
                                <StackPanel Width="140" Margin="0,0,10,8"><TextBlock Text="NBS (9 díg.)"/><TextBox x:Name="TxtCodNbs" Style="{StaticResource ModernTextBox}" ToolTip="Obrigatório se incluir IBS/CBS"/></StackPanel>
                                <StackPanel Width="560" Margin="0,0,10,8"><TextBlock Text="Descrição do serviço *"/><TextBox x:Name="TxtDescServico" Style="{StaticResource ModernTextBox}"/></StackPanel>
                            </WrapPanel>

                            <TextBlock Text="Valores / ISS *" FontWeight="Bold" Foreground="{DynamicResource TitleBrush}" Margin="0,8,0,8"/>
                            <WrapPanel>
                                <StackPanel Width="140" Margin="0,0,10,8"><TextBlock Text="Valor do serviço *"/><TextBox x:Name="TxtValorServico" Style="{StaticResource ModernTextBox}"/></StackPanel>
                                <StackPanel Width="200" Margin="0,0,10,8">
                                    <TextBlock Text="Tributação ISSQN *"/>
                                    <ComboBox x:Name="CbTribIssqn" SelectedIndex="0">
                                        <ComboBoxItem Content="1 — Operação tributável" Tag="1"/>
                                        <ComboBoxItem Content="2 — Exportação" Tag="2"/>
                                        <ComboBoxItem Content="3 — Não incidência" Tag="3"/>
                                        <ComboBoxItem Content="4 — Imunidade" Tag="4"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Width="220" Margin="0,0,10,8">
                                    <TextBlock Text="Retenção ISS *"/>
                                    <ComboBox x:Name="CbTpRetIssqn" SelectedIndex="0">
                                        <ComboBoxItem Content="1 — Não retido" Tag="1"/>
                                        <ComboBoxItem Content="2 — Retido pelo tomador" Tag="2"/>
                                        <ComboBoxItem Content="3 — Retido pelo intermediário" Tag="3"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Width="100" Margin="0,0,10,8"><TextBlock Text="Alíquota ISS %"/><TextBox x:Name="TxtAliqIss" Style="{StaticResource ModernTextBox}" Text="5"
                                             ToolTip="Com município ATIVO no Sistema Nacional a SEFIN não aceita pAliq (E0617 não-optante / E0625 ME-EPP). O campo fica só para referência / pTotTrib."/></StackPanel>
                            </WrapPanel>

                            <TextBlock Text="Regime do prestador (DPS)" FontWeight="Bold" Foreground="{DynamicResource TitleBrush}" Margin="0,8,0,8"/>
                            <WrapPanel>
                                <StackPanel Width="220" Margin="0,0,10,8">
                                    <TextBlock Text="opSimpNac"/>
                                    <ComboBox x:Name="CbOpSimpNac" SelectedIndex="0"
                                              ToolTip="Deve bater com o cadastro do CNPJ no Simples Nacional na competência (SEFIN E0160)">
                                        <ComboBoxItem Content="1 — Não optante" Tag="1"/>
                                        <ComboBoxItem Content="2 — MEI" Tag="2"/>
                                        <ComboBoxItem Content="3 — ME/EPP (Simples)" Tag="3"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Width="420" Margin="0,0,10,8">
                                    <TextBlock Text="regApTribSN (obrigatório se ME/EPP)"/>
                                    <ComboBox x:Name="CbRegApTribSN" SelectedIndex="0"
                                              ToolTip="SEFIN E0166: obrigatório quando opSimpNac = 3 (ME/EPP)">
                                        <ComboBoxItem Content="1 — Tributos federais e municipal pelo SN" Tag="1"/>
                                        <ComboBoxItem Content="2 — Federais pelo SN; ISSQN fora do SN" Tag="2"/>
                                        <ComboBoxItem Content="3 — Federais e municipal fora do SN" Tag="3"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Width="140" Margin="0,0,10,8"><TextBlock Text="regEspTrib"/><TextBox x:Name="TxtRegEspTrib" Style="{StaticResource ModernTextBox}" Text="0"/></StackPanel>
                            </WrapPanel>

                            <TextBlock Text="IBS / CBS (opcional)" FontWeight="Bold" Foreground="{DynamicResource TitleBrush}" Margin="0,8,0,8"/>
                            <WrapPanel>
                                <CheckBox x:Name="ChkIbsCbs" Content="Incluir classificação IBS/CBS" VerticalAlignment="Center" Margin="0,0,16,8"/>
                                <StackPanel Width="100" Margin="0,0,10,8"><TextBlock Text="CST"/><TextBox x:Name="TxtCstIbsCbs" Style="{StaticResource ModernTextBox}" Text="000"/></StackPanel>
                                <StackPanel Width="120" Margin="0,0,10,8"><TextBlock Text="cClassTrib"/><TextBox x:Name="TxtClassTrib" Style="{StaticResource ModernTextBox}" Text="000001"/></StackPanel>
                                <StackPanel Width="120" Margin="0,0,10,8"><TextBlock Text="cIndOp"/><TextBox x:Name="TxtCodIndOp" Style="{StaticResource ModernTextBox}" Text="000001"/></StackPanel>
                            </WrapPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,8"
                                       Text="Prestador vem das Configurações (CNPJ; IM só se real). Com tpEmit=1 não enviamos xNome nem endereço do prestador (SEFIN E0121/E0128). CNPJ do tomador precisa existir na RF."/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Cancelar" Padding="14,6" Margin="0,0,8,0" Click="BtnFecharForm_Click"
                                Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                        <Button Content="💾 Salvar" Style="{StaticResource HoverButtonStyle}" Padding="14,6" Click="BtnSalvar_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
