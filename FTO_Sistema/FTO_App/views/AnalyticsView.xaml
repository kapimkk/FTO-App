<UserControl x:Class="FTO_App.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="780" d:DesignWidth="1200"
             Background="{DynamicResource WindowBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryColor}" Padding="15,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="/icons/fto.png" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="📊 Painel Analítico" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🔄 Atualizar" Background="Transparent" Foreground="White" BorderBrush="White" BorderThickness="1"
                            Padding="10,2" Margin="0,0,8,0" Click="BtnAtualizar_Click"/>
                    <Button Content="Voltar" Background="Transparent" Foreground="White" BorderBrush="White" BorderThickness="1"
                            Padding="10,2" Click="BtnBack_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Filtros de período -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" Padding="12,8"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Período:" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="CbFiltroMes" Width="120" Margin="0,0,5,0" ToolTip="Mês"/>
                <ComboBox x:Name="CbFiltroAno" Width="85" Margin="0,0,10,0" ToolTip="Ano"/>
                <ComboBox x:Name="CbFiltroFormaPag" Width="130" Margin="0,0,10,0" ToolTip="Forma de Pagamento"/>
                <Button Content="🔍 Aplicar Filtros" Style="{StaticResource HoverButtonStyle}" Click="BtnAplicarFiltros_Click" Padding="12,5"/>
            </StackPanel>
        </Border>

        <!-- KPI Cards -->
        <Border Grid.Row="2" Background="{DynamicResource WindowBackgroundBrush}" Padding="10,10,10,0">
            <UniformGrid Rows="1" Columns="6">

                <Border Margin="0,0,6,0" Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="#0b3d91" BorderThickness="0,3,0,0" CornerRadius="6" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="💰 TOTAL VENDAS" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold"/>
                        <TextBlock x:Name="KpiVendas" Text="R$ 0,00" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TitleBrush}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="KpiVendasQtd" Text="0 registros" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Margin="0,0,6,0" Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="#C62828" BorderThickness="0,3,0,0" CornerRadius="6" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="💸 TOTAL GASTOS" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold"/>
                        <TextBlock x:Name="KpiGastos" Text="R$ 0,00" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource NegativeBrush}" Margin="0,4,0,0"/>
                        <TextBlock Text="custos operacionais" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Margin="0,0,6,0" Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="#2E7D32" BorderThickness="0,3,0,0" CornerRadius="6" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="📈 LUCRO LÍQUIDO" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold"/>
                        <TextBlock x:Name="KpiLucro" Text="R$ 0,00" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PositiveBrush}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="KpiMargemPct" Text="margem 0%" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Margin="0,0,6,0" Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="#FF6F00" BorderThickness="0,3,0,0" CornerRadius="6" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="🎯 TICKET MÉDIO" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold"/>
                        <TextBlock x:Name="KpiTicket" Text="R$ 0,00" FontSize="20" FontWeight="Bold" Foreground="#FF6F00" Margin="0,4,0,0"/>
                        <TextBlock Text="por venda" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Margin="0,0,6,0" Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="#2E7D32" BorderThickness="0,3,0,0" CornerRadius="6" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="✅ VENDAS PAGAS" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold"/>
                        <TextBlock x:Name="KpiPagas" Text="R$ 0,00" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PositiveBrush}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="KpiPagasQtd" Text="0 registros" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Margin="0" Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="#C62828" BorderThickness="0,3,0,0" CornerRadius="6" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="⏳ EM ABERTO" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold"/>
                        <TextBlock x:Name="KpiAberto" Text="R$ 0,00" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource NegativeBrush}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="KpiAbertoQtd" Text="0 registros" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>

            </UniformGrid>
        </Border>

        <!-- Corpo principal: Gráficos + Tabelas -->
        <Grid Grid.Row="3" Margin="10,8,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="180"/>
            </Grid.RowDefinitions>

            <!-- Gráfico de Barras: Vendas por Mês -->
            <Border Grid.Column="0" Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                    Margin="0,0,8,0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="📅 Vendas por Mês" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ChartVendasMes">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="3,0" VerticalAlignment="Bottom" Width="72">
                                        <TextBlock Text="{Binding ValorLabel}" HorizontalAlignment="Center"
                                                   FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,0,0,3" TextWrapping="NoWrap"/>
                                        <Rectangle Fill="{DynamicResource PrimaryColor}" Height="{Binding BarHeight}"
                                                   Width="52" RadiusX="4" RadiusY="4" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center"
                                                   FontSize="10" Margin="0,4,0,0" Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold" TextAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Lateral direita: Pizza + Top Clientes -->
            <Grid Grid.Column="1" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Gráfico de Pizza: Forma de Pagamento -->
                <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="💳 Forma de Pagamento" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,8"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Stretch="Uniform" MaxHeight="120">
                                <Canvas x:Name="CanvasPizza" Width="120" Height="120"/>
                            </Viewbox>
                            <ItemsControl Grid.Column="1" x:Name="LegendaPizza" VerticalAlignment="Center" Margin="8,0,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <Rectangle Fill="{Binding Cor}" Width="12" Height="12" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text=" " FontSize="10"/>
                                            <TextBlock Text="{Binding PctLabel}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Top Clientes mini -->
                <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="🏆 Top 5 Clientes" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="ListTopClientes">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="{Binding Rank}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Width="18"/>
                                        <TextBlock Text="{Binding ValorFormatado}" FontWeight="Bold" Foreground="{DynamicResource PositiveBrush}" FontSize="11" DockPanel.Dock="Right"/>
                                        <TextBlock Text="{Binding Cliente}" Foreground="{DynamicResource TextBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Vendas Recentes (bottom) -->
            <Border Grid.Column="0" Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                    Padding="12,10" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="🕐 Vendas Recentes" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,6"/>
                    <DataGrid Grid.Row="1" x:Name="GridRecentes" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" RowHeight="22" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource GridLinesBrush}"
                              Background="{DynamicResource CardBackgroundBrush}"
                              BorderThickness="0" HeadersVisibility="Column">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource GridHeaderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource GridHeaderForeground}"/>
                                <Setter Property="Padding" Value="6,3"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FontSize" Value="11"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data" Binding="{Binding DataFormatada}" Width="80"/>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="*"/>
                            <DataGridTextColumn Header="Serviço" Binding="{Binding TipoServico}" Width="120"/>
                            <DataGridTextColumn Header="Venda" Binding="{Binding VendaFormatada}" Width="85"/>
                            <DataGridTextColumn Header="Lucro" Binding="{Binding LucrosFormatado}" Width="85"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Pago}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Estoque Bottom -->
            <Border Grid.Column="1" Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="📦 Resumo Estoque" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,8"/>
                    <DockPanel Margin="0,4"><TextBlock Text="Total de Produtos:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                        <TextBlock x:Name="EstTotalProd" Text="—" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource TitleBrush}"/></DockPanel>
                    <DockPanel Margin="0,4"><TextBlock Text="Itens em Estoque:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                        <TextBlock x:Name="EstTotalItens" Text="—" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource TitleBrush}"/></DockPanel>
                    <DockPanel Margin="0,4"><TextBlock Text="Valor do Estoque:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                        <TextBlock x:Name="EstValorTotal" Text="—" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource PositiveBrush}"/></DockPanel>
                    <DockPanel Margin="0,4"><TextBlock Text="Produtos sem estoque:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                        <TextBlock x:Name="EstSemEstoque" Text="—" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource NegativeBrush}"/></DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Rodapé -->
        <Border Grid.Row="4" Background="{DynamicResource CardBackgroundBrush}" Margin="10,6,10,10"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,6">
            <DockPanel>
                <TextBlock x:Name="LblUltimaAtualizacao" Text="Última atualização: —" FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
