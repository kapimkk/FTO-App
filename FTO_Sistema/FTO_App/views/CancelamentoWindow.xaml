<Window x:Class="FTO_App.Views.CancelamentoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cancelar nota fiscal" Height="330" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource CardBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🛑 Cancelar nota fiscal" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" x:Name="LblResumo" TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Justificativa (mínimo 15 caracteres)" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtJustificativa" Style="{StaticResource ModernTextBox}" Height="90"
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancelar" Padding="12,6" Margin="0,0,8,0" Click="BtnFechar_Click"
                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
            <Button Content="🛑 Confirmar cancelamento" Padding="12,6" Click="BtnConfirmar_Click"
                    Background="{DynamicResource ActionDelBg}" Foreground="{DynamicResource ActionDelFg}" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
