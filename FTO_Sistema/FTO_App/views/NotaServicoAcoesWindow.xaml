<Window x:Class="FTO_App.Views.NotaServicoAcoesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ações NFS-e" Height="580" Width="660"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource CardBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="LblTitulo" Text="⚡ Ações NFS-e" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="1" x:Name="LblResumo" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,12"/>

        <WrapPanel Grid.Row="2" Margin="0,0,0,10">
            <StackPanel Width="280" Margin="0,0,16,8">
                <TextBlock Text="Ambiente SEFIN"/>
                <ComboBox x:Name="CbAmbiente" SelectedIndex="0"
                          ToolTip="tpAmb=2 → produção restrita; tpAmb=1 → produção nacional (URL sem /API).">
                    <ComboBoxItem Content="2 — Homologação (produção restrita)" Tag="2"/>
                    <ComboBoxItem Content="1 — Produção nacional" Tag="1"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Width="300" Margin="0,0,16,8">
                <TextBlock Text="opSimpNac (cadastro Simples Nacional)"/>
                <ComboBox x:Name="CbOpSimpNac" SelectedIndex="0"
                          ToolTip="SEFIN E0160: deve bater com o SN do CNPJ na competência">
                    <ComboBoxItem Content="1 — Não optante" Tag="1"/>
                    <ComboBoxItem Content="2 — MEI" Tag="2"/>
                    <ComboBoxItem Content="3 — ME/EPP (Simples)" Tag="3"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Width="420" Margin="0,0,16,8">
                <TextBlock Text="regApTribSN (só ME/EPP)"/>
                <ComboBox x:Name="CbRegApTribSN" SelectedIndex="0">
                    <ComboBoxItem Content="1 — Tributos federais e municipal pelo SN" Tag="1"/>
                    <ComboBoxItem Content="2 — Federais pelo SN; ISSQN fora do SN" Tag="2"/>
                    <ComboBoxItem Content="3 — Federais e municipal fora do SN" Tag="3"/>
                </ComboBox>
            </StackPanel>
            <TextBlock x:Name="LblDica" Width="600" TextWrapping="Wrap" VerticalAlignment="Top"
                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                       Text="Homologação = produção restrita. Produção = sefin.nfse.gov.br/SefinNacional (sem /API). E0160: altere opSimpNac aqui e emita de novo."/>
        </WrapPanel>

        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="0,10" Margin="0,0,0,10">
            <WrapPanel>
                <StackPanel Width="420" Margin="0,0,10,8"><TextBlock Text="Chave de acesso (50 dígitos)"/><TextBox x:Name="TxtChaveAcesso" Style="{StaticResource ModernTextBox}" IsReadOnly="True"/></StackPanel>
                <StackPanel Width="180" Margin="0,0,10,8"><TextBlock Text="Id DPS"/><TextBox x:Name="TxtIdDps" Style="{StaticResource ModernTextBox}" IsReadOnly="True"/></StackPanel>
                <StackPanel Width="600" Margin="0,0,0,8"><TextBlock Text="Situação SEFIN"/><TextBox x:Name="TxtStatusFiscal" Style="{StaticResource ModernTextBox}" IsReadOnly="True" TextWrapping="Wrap"/></StackPanel>
            </WrapPanel>
        </Border>

        <WrapPanel Grid.Row="4" VerticalAlignment="Top">
            <Button x:Name="BtnEmitirApi" Content="🚀 EMITIR NFS-e (SEFIN)" Style="{StaticResource HoverButtonStyle}" Padding="12,6" Margin="0,0,8,8" Click="BtnEmitirApi_Click"/>
            <Button x:Name="BtnBaixarXml" Content="⬇️ Baixar XML" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,8,8" Click="BtnBaixarXml_Click"/>
            <Button x:Name="BtnVerXml" Content="👁️ Ver XML" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,8,8" Click="BtnVerXml_Click"/>
            <Button x:Name="BtnDanfse" Content="🖨️ Baixar DANFSE" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,8,8" Click="BtnDanfse_Click"
                    ToolTip="Baixa o PDF do DANFSe pela API Fiscal (NFS-e). Se a rota falhar, gera local a partir do XML."/>
            <Button x:Name="BtnCancelarNota" Content="🛑 Cancelar NFS-e" Background="{DynamicResource ActionDelBg}" Foreground="{DynamicResource ActionDelFg}"
                    BorderThickness="0" Padding="10,5" Margin="0,0,8,8" Click="BtnCancelarNota_Click"/>
        </WrapPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Fechar" Padding="12,6" Click="BtnFechar_Click"
                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
        </StackPanel>
    </Grid>
</Window>
