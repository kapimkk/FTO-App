<Window x:Class="FTO_App.Views.InutilizacaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inutilizar numeração de NF-e" Height="420" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource CardBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🚫 Inutilizar faixa de numeração (NF-e, modelo 55)" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"
                   Text="Use apenas para números que NUNCA foram emitidos (falha de sequência, pulo de numeração). Prazo: até o dia 5 do mês seguinte."/>

        <WrapPanel Grid.Row="2">
            <StackPanel Width="90" Margin="0,0,10,8"><TextBlock Text="Ano"/><TextBox x:Name="TxtAno" Style="{StaticResource ModernTextBox}"/></StackPanel>
            <StackPanel Width="90" Margin="0,0,10,8"><TextBlock Text="Série"/><TextBox x:Name="TxtSerie" Style="{StaticResource ModernTextBox}" Text="1"/></StackPanel>
            <StackPanel Width="140" Margin="0,0,10,8"><TextBlock Text="Número inicial"/><TextBox x:Name="TxtNumeroInicial" Style="{StaticResource ModernTextBox}"/></StackPanel>
            <StackPanel Width="140" Margin="0,0,10,8"><TextBlock Text="Número final"/><TextBox x:Name="TxtNumeroFinal" Style="{StaticResource ModernTextBox}"/></StackPanel>
        </WrapPanel>

        <StackPanel Grid.Row="3">
            <TextBlock Text="Justificativa (mínimo 15 caracteres)" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtJustificativa" Style="{StaticResource ModernTextBox}" Height="90"
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancelar" Padding="12,6" Margin="0,0,8,0" Click="BtnFechar_Click"
                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
            <Button Content="🚫 Confirmar inutilização" Style="{StaticResource HoverButtonStyle}" Padding="12,6" Click="BtnConfirmar_Click"/>
        </StackPanel>
    </Grid>
</Window>
