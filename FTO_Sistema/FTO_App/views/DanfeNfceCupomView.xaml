<UserControl x:Class="FTO_App.Views.DanfeNfceCupomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="302">

    <UserControl.Resources>
        <Style x:Key="DanfeTexto" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style x:Key="DanfeRotulo" TargetType="TextBlock" BasedOn="{StaticResource DanfeTexto}">
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="DanfeValor" TargetType="TextBlock" BasedOn="{StaticResource DanfeTexto}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>

        <Style x:Key="DanfeLinha" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="DanfeEmpresaDetalhe" TargetType="TextBlock" BasedOn="{StaticResource DanfeTexto}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DanfeEmpresaTitulo" TargetType="TextBlock" BasedOn="{StaticResource DanfeTexto}">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="DanfeSecaoTitulo" TargetType="TextBlock" BasedOn="{StaticResource DanfeTexto}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <Border x:Name="BorderCupom"
            Width="302"
            Background="White"
            Padding="10,18"
            HorizontalAlignment="Center"
            RenderOptions.BitmapScalingMode="HighQuality"
            TextOptions.TextRenderingMode="ClearType"
            TextOptions.TextFormattingMode="Display">
        <StackPanel HorizontalAlignment="Stretch" Margin="-48,0,0,0">

            <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,10">
                <Image x:Name="ImgLogoEmitente" Height="48" Margin="0,0,0,8" HorizontalAlignment="Center"
                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtEmpresaNome"
                           Style="{StaticResource DanfeEmpresaTitulo}"
                           FontSize="17" FontWeight="Bold" Foreground="Black"/>
                <TextBlock x:Name="TxtEmpresaEndereco" Style="{StaticResource DanfeEmpresaDetalhe}" Margin="0,4,0,0"/>
                <TextBlock x:Name="TxtEmpresaCidade" Style="{StaticResource DanfeEmpresaDetalhe}" Margin="0,3,0,0"/>
                <TextBlock x:Name="TxtEmpresaCnpj" Style="{StaticResource DanfeEmpresaDetalhe}" Margin="0,3,0,0"/>
                <TextBlock x:Name="TxtEmpresaIe" Style="{StaticResource DanfeEmpresaDetalhe}" Margin="0,3,0,0"/>
            </StackPanel>

            <Border Height="1" Background="Black" Opacity="0.2" Margin="0,0,0,8"/>

            <TextBlock Text="DANFE NFC-e" Style="{StaticResource DanfeEmpresaTitulo}"
                       FontSize="15" FontWeight="Bold" Foreground="Black"/>
            <TextBlock Text="Documento Auxiliar da Nota Fiscal de Consumidor Eletrônica"
                       Style="{StaticResource DanfeEmpresaDetalhe}" Margin="0,2,0,10"/>

            <Border x:Name="BorderHomolog" Background="#FFF3CD" BorderBrush="#FFC107" BorderThickness="1"
                    Padding="6,4" Margin="0,0,0,10" Visibility="Collapsed">
                <TextBlock Text="AMBIENTE DE HOMOLOGAÇÃO — SEM VALOR FISCAL"
                           FontSize="11" FontWeight="Bold" Foreground="#7A5A00"
                           TextAlignment="Center" TextWrapping="Wrap"/>
            </Border>

            <Border Height="1" Background="Black" Opacity="0.2" Margin="0,0,0,8"/>

            <TextBlock Text="ITEM" Style="{StaticResource DanfeSecaoTitulo}"/>
            <TextBlock x:Name="TxtItemDescricao" FontSize="13" FontWeight="SemiBold" Foreground="Black"
                       TextWrapping="Wrap" Margin="0,0,0,3"/>
            <StackPanel Style="{StaticResource DanfeLinha}" Margin="0,0,0,10">
                <TextBlock x:Name="TxtItemQtdUnit" Style="{StaticResource DanfeRotulo}" FontWeight="Normal"/>
                <TextBlock x:Name="TxtItemTotal" Style="{StaticResource DanfeValor}" HorizontalAlignment="Right"/>
            </StackPanel>

            <Border Height="1" Background="Black" Opacity="0.2" Margin="0,0,0,10"/>

            <StackPanel Style="{StaticResource DanfeLinha}" Margin="0,0,0,4">
                <TextBlock Text="Qtd. total de itens:" Style="{StaticResource DanfeRotulo}"/>
                <TextBlock x:Name="TxtQtdTotalItens" Style="{StaticResource DanfeValor}"/>
            </StackPanel>
            <StackPanel Style="{StaticResource DanfeLinha}" Margin="0,0,0,10">
                <TextBlock Text="VALOR TOTAL R$" FontSize="15" FontWeight="Bold" Foreground="Black"/>
                <TextBlock x:Name="TxtValorTotal" FontSize="20" FontWeight="Bold" Foreground="Black" Margin="8,0,0,0"/>
            </StackPanel>

            <Border Height="1" Background="Black" Opacity="0.2" Margin="0,0,0,10"/>

            <TextBlock Text="FORMA DE PAGAMENTO" Style="{StaticResource DanfeSecaoTitulo}"/>
            <StackPanel Style="{StaticResource DanfeLinha}" Margin="0,0,0,10">
                <TextBlock x:Name="TxtFormaPagamento" Style="{StaticResource DanfeValor}" Margin="0"/>
            </StackPanel>

            <Border Height="1" Background="Black" Opacity="0.2" Margin="0,0,0,10"/>

            <TextBlock Text="CONSUMIDOR" Style="{StaticResource DanfeSecaoTitulo}"/>
            <TextBlock x:Name="TxtConsumidor" FontSize="13" FontWeight="SemiBold" Foreground="Black"
                       TextWrapping="Wrap" Margin="0,0,0,10"/>

            <Border Height="1" Background="Black" Opacity="0.2" Margin="0,0,0,10"/>

            <StackPanel Style="{StaticResource DanfeLinha}" Margin="0,0,0,4">
                <TextBlock Text="NFC-e nº:" Style="{StaticResource DanfeRotulo}"/>
                <TextBlock x:Name="TxtNumeroSerie" Style="{StaticResource DanfeValor}"/>
            </StackPanel>
            <StackPanel Style="{StaticResource DanfeLinha}" Margin="0,0,0,10">
                <TextBlock Text="Emissão:" Style="{StaticResource DanfeRotulo}"/>
                <TextBlock x:Name="TxtDataEmissao" Style="{StaticResource DanfeValor}"/>
            </StackPanel>

            <TextBlock Text="Consulte pela Chave de Acesso em:" Style="{StaticResource DanfeEmpresaDetalhe}" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtChaveAcesso" Style="{StaticResource DanfeEmpresaDetalhe}"
                       FontFamily="Consolas" FontSize="12" Margin="0,0,0,10"/>

            <Border x:Name="BorderProtocolo" Margin="0,0,0,10">
                <TextBlock x:Name="TxtProtocolo" Style="{StaticResource DanfeEmpresaDetalhe}" FontSize="11"/>
            </Border>

            <Image x:Name="ImgQrCode" Width="160" Height="160" Margin="0,0,0,10"
                   HorizontalAlignment="Center" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="Collapsed"/>

            <TextBlock x:Name="TxtQrIndisponivel" Text="QR Code de consulta indisponível para esta nota."
                       Style="{StaticResource DanfeEmpresaDetalhe}" FontSize="11" Margin="0,0,0,10"
                       Visibility="Collapsed"/>

            <Border Height="1" Background="Black" Opacity="0.2" Margin="0,0,0,10"/>

            <TextBlock Text="Não permite aproveitamento de crédito de ICMS/IBS/CBS.&#10;Impresso via impressora térmica — não substitui o XML autorizado pela SEFAZ."
                       Style="{StaticResource DanfeEmpresaDetalhe}" FontSize="10" FontStyle="Italic"/>
        </StackPanel>
    </Border>
</UserControl>
