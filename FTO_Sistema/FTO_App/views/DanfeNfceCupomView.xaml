<UserControl x:Class="FTO_App.Views.DanfeNfceCupomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="302">

    <UserControl.Resources>
        <Style x:Key="DanfeTexto" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="DanfeRotulo" TargetType="TextBlock" BasedOn="{StaticResource DanfeTexto}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="DanfeValor" TargetType="TextBlock" BasedOn="{StaticResource DanfeTexto}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="DanfeEmpresaDetalhe" TargetType="TextBlock" BasedOn="{StaticResource DanfeTexto}">
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="DanfeEmpresaTitulo" TargetType="TextBlock" BasedOn="{StaticResource DanfeTexto}">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="DanfeSecaoTitulo" TargetType="TextBlock" BasedOn="{StaticResource DanfeTexto}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="DanfeSeparador" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Opacity" Value="0.25"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>

    <Border x:Name="BorderCupom"
            Width="302"
            Background="White"
            Padding="12,16"
            HorizontalAlignment="Center"
            RenderOptions.BitmapScalingMode="HighQuality"
            TextOptions.TextRenderingMode="ClearType"
            TextOptions.TextFormattingMode="Display">
        <StackPanel HorizontalAlignment="Stretch">

            <!-- Emitente -->
            <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,8">
                <TextBlock x:Name="TxtEmpresaNome"
                           Style="{StaticResource DanfeEmpresaTitulo}"
                           FontSize="16"/>
                <TextBlock x:Name="TxtEmpresaEndereco" Style="{StaticResource DanfeEmpresaDetalhe}" Margin="0,4,0,0"/>
                <TextBlock x:Name="TxtEmpresaCidade" Style="{StaticResource DanfeEmpresaDetalhe}" Margin="0,2,0,0"/>
                <TextBlock x:Name="TxtEmpresaCnpj" Style="{StaticResource DanfeEmpresaDetalhe}" Margin="0,2,0,0"/>
                <TextBlock x:Name="TxtEmpresaIe" Style="{StaticResource DanfeEmpresaDetalhe}" Margin="0,2,0,0"/>
            </StackPanel>

            <Border Style="{StaticResource DanfeSeparador}"/>

            <TextBlock Text="DANFE NFC-e" Style="{StaticResource DanfeEmpresaTitulo}" FontSize="14"/>
            <TextBlock Text="Documento Auxiliar da Nota Fiscal de Consumidor Eletrônica"
                       Style="{StaticResource DanfeEmpresaDetalhe}" FontSize="10" Margin="0,2,0,8"/>

            <Border x:Name="BorderHomolog" Background="#FFF3CD" BorderBrush="#FFC107" BorderThickness="1"
                    Padding="6,4" Margin="0,0,0,8" Visibility="Collapsed">
                <TextBlock Text="AMBIENTE DE HOMOLOGAÇÃO — SEM VALOR FISCAL"
                           FontSize="11" FontWeight="Bold" Foreground="#7A5A00"
                           TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Stretch"/>
            </Border>

            <Border Style="{StaticResource DanfeSeparador}"/>

            <!-- Item (mesma coluna visual do consumidor / demais dados) -->
            <TextBlock Text="ITEM" Style="{StaticResource DanfeSecaoTitulo}"/>
            <TextBlock x:Name="TxtItemDescricao" Style="{StaticResource DanfeValor}" FontSize="13"/>
            <TextBlock x:Name="TxtItemQtdUnit" Style="{StaticResource DanfeValor}" FontWeight="Normal" FontSize="12" Margin="0,0,0,2"/>
            <TextBlock x:Name="TxtItemTotal" Style="{StaticResource DanfeValor}" FontSize="13"/>

            <Border Style="{StaticResource DanfeSeparador}"/>

            <TextBlock Text="Qtd. total de itens" Style="{StaticResource DanfeRotulo}"/>
            <TextBlock x:Name="TxtQtdTotalItens" Style="{StaticResource DanfeValor}"/>

            <TextBlock Text="VALOR TOTAL R$" Style="{StaticResource DanfeRotulo}" FontSize="13"/>
            <TextBlock x:Name="TxtValorTotal" Style="{StaticResource DanfeValor}"
                       FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>

            <Border Style="{StaticResource DanfeSeparador}"/>

            <TextBlock Text="FORMA DE PAGAMENTO" Style="{StaticResource DanfeSecaoTitulo}"/>
            <TextBlock x:Name="TxtFormaPagamento" Style="{StaticResource DanfeValor}"/>

            <Border Style="{StaticResource DanfeSeparador}"/>

            <TextBlock Text="CONSUMIDOR" Style="{StaticResource DanfeSecaoTitulo}"/>
            <TextBlock x:Name="TxtConsumidor" Style="{StaticResource DanfeValor}"/>

            <Border Style="{StaticResource DanfeSeparador}"/>

            <TextBlock Text="NFC-e nº / Série" Style="{StaticResource DanfeRotulo}"/>
            <TextBlock x:Name="TxtNumeroSerie" Style="{StaticResource DanfeValor}"/>

            <TextBlock Text="Emissão" Style="{StaticResource DanfeRotulo}"/>
            <TextBlock x:Name="TxtDataEmissao" Style="{StaticResource DanfeValor}"/>

            <Border Style="{StaticResource DanfeSeparador}"/>

            <TextBlock Text="Consulte pela Chave de Acesso em:"
                       Style="{StaticResource DanfeEmpresaDetalhe}" FontSize="10" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtChaveAcesso" Style="{StaticResource DanfeEmpresaDetalhe}"
                       FontFamily="Consolas" FontSize="10" Margin="0,0,0,8"/>

            <Border x:Name="BorderProtocolo" Margin="0,0,0,8">
                <TextBlock x:Name="TxtProtocolo" Style="{StaticResource DanfeEmpresaDetalhe}" FontSize="11"/>
            </Border>

            <Image x:Name="ImgQrCode" Width="150" Height="150" Margin="0,0,0,8"
                   HorizontalAlignment="Center" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="Collapsed"/>

            <TextBlock x:Name="TxtQrIndisponivel" Text="QR Code de consulta indisponível para esta nota."
                       Style="{StaticResource DanfeEmpresaDetalhe}" FontSize="11" Margin="0,0,0,8"
                       Visibility="Collapsed"/>

            <Border Style="{StaticResource DanfeSeparador}" Margin="0,0,0,6"/>

            <TextBlock Text="Não permite aproveitamento de crédito de ICMS/IBS/CBS.&#10;Impresso via impressora térmica — não substitui o XML autorizado pela SEFAZ."
                       Style="{StaticResource DanfeEmpresaDetalhe}" FontSize="9" FontStyle="Italic"/>
        </StackPanel>
    </Border>
</UserControl>
