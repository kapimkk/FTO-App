<UserControl x:Class="FTO_App.Views.NotaFiscalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PrimaryColor}" Padding="15,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🧾 Nota Fiscal (NF-e)" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="  · XML local" Foreground="#cbd5e1" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" Padding="10" Margin="10,10,10,0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="TxtBusca" Width="240" Style="{StaticResource ModernTextBox}"
                         ToolTip="Buscar destinatário ou número" TextChanged="TxtBusca_TextChanged"/>
                <ComboBox x:Name="CbFiltroStatus" Width="130" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="Filtro_Changed">
                    <ComboBoxItem Content="Todos status"/>
                    <ComboBoxItem Content="Rascunho" Tag="Rascunho"/>
                    <ComboBoxItem Content="XML gerado" Tag="XML gerado"/>
                </ComboBox>
                <Button Content="🔍 Filtrar" Style="{StaticResource ToolbarButtonStyle}" Margin="8,0,0,0" Click="BtnFiltrar_Click"/>
                <Button Content="+ Cadastrar NF" Style="{StaticResource HoverButtonStyle}" Width="140" Margin="8,0,0,0" Click="BtnNovo_Click"/>
                <Button Content="✏️ Editar" Style="{StaticResource ToolbarButtonStyle}" Margin="8,0,0,0" Click="BtnEditar_Click"/>
                <Button Content="🗑️ Excluir" Background="{DynamicResource ActionDelBg}" Foreground="{DynamicResource ActionDelFg}"
                        BorderThickness="0" Padding="10,5" Margin="8,0,0,0" Click="BtnExcluirLista_Click"/>
                <Button Content="🚫 Inutilizar numeração" Style="{StaticResource ToolbarButtonStyle}" Margin="8,0,0,0" Click="BtnInutilizar_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="10" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0" x:Name="GridNotas" Margin="0" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" MouseDoubleClick="Grid_MouseDoubleClick"
                          Background="{DynamicResource CardBackgroundBrush}" BorderThickness="0" RowHeight="26">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nº" Binding="{Binding NumeroExibicao}" Width="70"/>
                        <DataGridTextColumn Header="Emissão" Binding="{Binding DataEmissaoFormatada}" Width="120"/>
                        <DataGridTextColumn Header="Destinatário" Binding="{Binding DestNome}" Width="*"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding ValorTotalFormatado}" Width="100"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Situação SEFAZ" Binding="{Binding SituacaoFiscalExibicao}" Width="220"/>
                        <DataGridTextColumn Header="XML" Binding="{Binding CaminhoXml}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="1" Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content=" Anterior " Click="BtnPrev_Click"
                                Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                        <TextBlock x:Name="LblPageInfo" Text="Pág 1/1" VerticalAlignment="Center" Margin="10,0"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <Button Content=" Próxima " Click="BtnNext_Click"
                                Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="FormOverlay" Grid.RowSpan="3" Background="#99000000" Visibility="Collapsed" Panel.ZIndex="200">
            <Border Background="{DynamicResource CardBackgroundBrush}" Margin="30,20" CornerRadius="8" Padding="16"
                    MaxWidth="980" VerticalAlignment="Center" MaxHeight="680">
                <Border.Effect><DropShadowEffect BlurRadius="24"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,10">
                        <TextBlock x:Name="LblFormTitulo" Text="Cadastrar nota fiscal" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TitleBrush}"/>
                        <Button DockPanel.Dock="Right" Content="✕" Width="32" Height="28" Click="BtnFecharForm_Click"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Identificação (ide)" FontWeight="Bold" Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <StackPanel Width="260" Margin="0,0,10,8">
                                    <TextBlock Text="Natureza da operação (descrição)"/>
                                    <ComboBox x:Name="CbNatOp" IsEditable="True" SelectedIndex="0"
                                              ToolTip="Texto livre enviado em natOp (máx. 60 caracteres). Não é CFOP — o CFOP fica no produto.">
                                        <ComboBoxItem Content="Venda de mercadoria"/>
                                        <ComboBoxItem Content="Venda a consumidor final"/>
                                        <ComboBoxItem Content="Prestação de serviço"/>
                                        <ComboBoxItem Content="Devolução de mercadoria"/>
                                        <ComboBoxItem Content="Remessa para demonstração"/>
                                        <ComboBoxItem Content="Bonificação"/>
                                    </ComboBox>
                                    <TextBlock Text="Descrição curta (não é código). CFOP é outro campo."
                                               FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Width="220" Margin="0,0,10,8">
                                    <TextBlock Text="Modelo"/>
                                    <ComboBox x:Name="CbModelo" SelectedIndex="0"
                                              ToolTip="55 = NF-e (nota fiscal eletrônica). 65 = NFC-e (cupom fiscal ao consumidor).">
                                        <ComboBoxItem Content="55 — NF-e (empresa / B2B)" Tag="55"/>
                                        <ComboBoxItem Content="65 — NFC-e (consumidor / cupom)" Tag="65"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Width="80" Margin="0,0,10,8"><TextBlock Text="Série"/><TextBox x:Name="TxtSerie" Style="{StaticResource ModernTextBox}" Text="1"/></StackPanel>
                                <StackPanel Width="100" Margin="0,0,10,8"><TextBlock Text="Número"/><TextBox x:Name="TxtNumero" Style="{StaticResource ModernTextBox}"/></StackPanel>
                                <StackPanel Width="160" Margin="0,0,10,8"><TextBlock Text="Data emissão"/><DatePicker x:Name="DpEmissao" Height="28"/></StackPanel>
                                <StackPanel Width="120" Margin="0,0,10,8"><TextBlock Text="Tipo"/><ComboBox x:Name="CbTipoOp" SelectedIndex="1"><ComboBoxItem Content="0-Entrada" Tag="0"/><ComboBoxItem Content="1-Saída" Tag="1"/></ComboBox></StackPanel>
                                <StackPanel Width="140" Margin="0,0,10,8"><TextBlock Text="Ambiente"/><ComboBox x:Name="CbAmbiente" SelectedIndex="1" SelectionChanged="CbAmbiente_SelectionChanged"><ComboBoxItem Content="1-Produção" Tag="1"/><ComboBoxItem Content="2-Homologação" Tag="2"/></ComboBox></StackPanel>
                                <StackPanel Width="140" Margin="0,0,10,8"><TextBlock Text="Finalidade"/><ComboBox x:Name="CbFinalidade" SelectedIndex="0"><ComboBoxItem Content="1-Normal" Tag="1"/><ComboBoxItem Content="2-Complementar" Tag="2"/><ComboBoxItem Content="3-Ajuste" Tag="3"/><ComboBoxItem Content="4-Devolução" Tag="4"/></ComboBox></StackPanel>
                                <StackPanel Width="160" Margin="0,0,10,8"><TextBlock Text="Destino (idDest)"/><ComboBox x:Name="CbIdDest" SelectedIndex="0"><ComboBoxItem Content="1-Interna" Tag="1"/><ComboBoxItem Content="2-Interestadual" Tag="2"/><ComboBoxItem Content="3-Exterior" Tag="3"/></ComboBox></StackPanel>
                                <StackPanel Width="150" Margin="0,0,10,8"><TextBlock Text="Consumidor final"/><ComboBox x:Name="CbIndFinal" SelectedIndex="1"><ComboBoxItem Content="0-Não" Tag="0"/><ComboBoxItem Content="1-Sim" Tag="1"/></ComboBox></StackPanel>
                                <StackPanel Width="160" Margin="0,0,10,8"><TextBlock Text="Presença (indPres)"/><ComboBox x:Name="CbIndPres" SelectedIndex="1"><ComboBoxItem Content="0-Não se aplica" Tag="0"/><ComboBoxItem Content="1-Presencial" Tag="1"/><ComboBoxItem Content="2-Internet" Tag="2"/><ComboBoxItem Content="3-Teleatendimento" Tag="3"/><ComboBoxItem Content="9-Outros" Tag="9"/></ComboBox></StackPanel>
                            </WrapPanel>
                            <TextBlock x:Name="LblHomologHint" Text="Homologação: dest.xNome e xProd serão ajustados automaticamente ao gerar o XML."
                                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Visible"/>

                            <TextBlock Text="Destinatário (dest)" FontWeight="Bold" Foreground="{DynamicResource TitleBrush}" Margin="0,10,0,8"/>
                            <WrapPanel>
                                <StackPanel Width="280" Margin="0,0,10,8"><TextBlock Text="Cliente cadastrado"/><ComboBox x:Name="CbCliente" DisplayMemberPath="Nome" SelectionChanged="CbCliente_SelectionChanged"/></StackPanel>
                                <StackPanel Width="260" Margin="0,0,10,8"><TextBlock Text="Nome"/><TextBox x:Name="TxtDestNome" Style="{StaticResource ModernTextBox}"/></StackPanel>
                                <StackPanel Width="160" Margin="0,0,10,8"><TextBlock Text="CPF/CNPJ"/><TextBox x:Name="TxtDestDoc" Style="{StaticResource ModernTextBox}"/></StackPanel>
                                <StackPanel Width="180" Margin="0,0,10,8"><TextBlock Text="IE destinatário (indIEDest)"/><ComboBox x:Name="CbIndIEDest" SelectedIndex="2" SelectionChanged="CbIndIEDest_SelectionChanged"><ComboBoxItem Content="1-Contribuinte" Tag="1"/><ComboBoxItem Content="2-Isento" Tag="2"/><ComboBoxItem Content="9-Não contribuinte" Tag="9"/></ComboBox></StackPanel>
                                <StackPanel Width="120" Margin="0,0,10,8"><TextBlock Text="IE"/><TextBox x:Name="TxtDestIe" Style="{StaticResource ModernTextBox}"/></StackPanel>
                                <StackPanel Width="220" Margin="0,0,10,8"><TextBlock Text="E-mail"/><TextBox x:Name="TxtDestEmail" Style="{StaticResource ModernTextBox}"/></StackPanel>
                                <StackPanel Width="260" Margin="0,0,10,8"><TextBlock Text="Logradouro"/><TextBox x:Name="TxtDestLgr" Style="{StaticResource ModernTextBox}"/></StackPanel>
                                <StackPanel Width="80" Margin="0,0,10,8"><TextBlock Text="Nº"/><TextBox x:Name="TxtDestNro" Style="{StaticResource ModernTextBox}"/></StackPanel>
                                <StackPanel Width="160" Margin="0,0,10,8"><TextBlock Text="Bairro"/><TextBox x:Name="TxtDestBairro" Style="{StaticResource ModernTextBox}"/></StackPanel>
                                <StackPanel Width="180" Margin="0,0,10,8"><TextBlock Text="Município"/><TextBox x:Name="TxtDestMun" Style="{StaticResource ModernTextBox}"/></StackPanel>
                                <StackPanel Width="60" Margin="0,0,10,8"><TextBlock Text="UF"/><TextBox x:Name="TxtDestUf" Style="{StaticResource ModernTextBox}" MaxLength="2" TextChanged="TxtDestUf_TextChanged"/></StackPanel>
                                <StackPanel Width="140" Margin="0,0,10,8">
                                    <TextBlock Text="CEP"/>
                                    <TextBox x:Name="TxtDestCep" Style="{StaticResource ModernTextBox}"
                                             KeyDown="TxtDestCep_KeyDown"
                                             ToolTip="Digite o CEP e pressione Enter para preencher endereço e IBGE (ViaCEP)."/>
                                    <TextBlock Text="Enter = preencher endereço"
                                               FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </StackPanel>
                                <StackPanel Width="110" Margin="0,0,10,8"><TextBlock Text="IBGE"/><TextBox x:Name="TxtDestIbge" Style="{StaticResource ModernTextBox}"/></StackPanel>
                            </WrapPanel>

                            <TextBlock Text="Produto / Impostos (det)" FontWeight="Bold" Foreground="{DynamicResource TitleBrush}" Margin="0,10,0,8"/>
                            <WrapPanel>
                                <StackPanel Width="100" Margin="0,0,10,8"><TextBlock Text="Código"/><TextBox x:Name="TxtProdCod" Style="{StaticResource ModernTextBox}" Text="001"/></StackPanel>
                                <StackPanel Width="280" Margin="0,0,10,8"><TextBlock Text="Descrição"/><TextBox x:Name="TxtProdDesc" Style="{StaticResource ModernTextBox}"/></StackPanel>
                                <StackPanel Width="110" Margin="0,0,10,8"><TextBlock Text="NCM"/><TextBox x:Name="TxtProdNcm" Style="{StaticResource ModernTextBox}"/></StackPanel>
                                <StackPanel Width="90" Margin="0,0,10,8"><TextBlock Text="CEST"/><TextBox x:Name="TxtProdCest" Style="{StaticResource ModernTextBox}" ToolTip="Obrigatório em ICMS-ST"/></StackPanel>
                                <StackPanel Width="110" Margin="0,0,10,8"><TextBlock Text="GTIN/EAN"/><TextBox x:Name="TxtProdGtin" Style="{StaticResource ModernTextBox}" Text="SEM GTIN"/></StackPanel>
                                <StackPanel Width="90" Margin="0,0,10,8"><TextBlock Text="CFOP"/><TextBox x:Name="TxtProdCfop" Style="{StaticResource ModernTextBox}" Text="5102" TextChanged="TxtProdCfop_TextChanged"/></StackPanel>
                                <StackPanel Width="70" Margin="0,0,10,8"><TextBlock Text="Unid."/><TextBox x:Name="TxtProdUn" Style="{StaticResource ModernTextBox}" Text="UN"/></StackPanel>
                                <StackPanel Width="80" Margin="0,0,10,8"><TextBlock Text="Qtd"/><TextBox x:Name="TxtProdQtd" Style="{StaticResource ModernTextBox}" Text="1" TextChanged="CalcTotais"/></StackPanel>
                                <StackPanel Width="110" Margin="0,0,10,8"><TextBlock Text="Vlr unit."/><TextBox x:Name="TxtProdVUnit" Style="{StaticResource ModernTextBox}" TextChanged="CalcTotais"/></StackPanel>
                                <StackPanel Width="110" Margin="0,0,10,8"><TextBlock Text="Vlr total"/><TextBox x:Name="TxtProdVTot" Style="{StaticResource ModernTextBox}" IsReadOnly="True"/></StackPanel>
                                <StackPanel Width="90" Margin="0,0,10,8"><TextBlock Text="Origem"/><ComboBox x:Name="CbIcmsOrigem" SelectedIndex="0"><ComboBoxItem Content="0-Nacional" Tag="0"/><ComboBoxItem Content="1-Estrangeira" Tag="1"/><ComboBoxItem Content="2-Estr. mercado" Tag="2"/></ComboBox></StackPanel>
                                <StackPanel x:Name="PanelCst" Width="90" Margin="0,0,10,8"><TextBlock Text="CST ICMS"/><TextBox x:Name="TxtIcmsCst" Style="{StaticResource ModernTextBox}" Text="00"/></StackPanel>
                                <StackPanel x:Name="PanelCsosn" Width="100" Margin="0,0,10,8"><TextBlock Text="CSOSN"/><ComboBox x:Name="CbCsosn" IsEditable="True" Text="102"><ComboBoxItem Content="101"/><ComboBoxItem Content="102"/><ComboBoxItem Content="103"/><ComboBoxItem Content="201"/><ComboBoxItem Content="202"/><ComboBoxItem Content="203"/><ComboBoxItem Content="300"/><ComboBoxItem Content="400"/><ComboBoxItem Content="500"/><ComboBoxItem Content="900"/></ComboBox></StackPanel>
                                <StackPanel Width="80" Margin="0,0,10,8"><TextBlock Text="ICMS %"/><TextBox x:Name="TxtIcmsAliq" Style="{StaticResource ModernTextBox}" Text="0" TextChanged="CalcTotais"/></StackPanel>
                                <StackPanel Width="80" Margin="0,0,10,8"><TextBlock Text="PIS CST"/><TextBox x:Name="TxtPisCst" Style="{StaticResource ModernTextBox}" Text="01"/></StackPanel>
                                <StackPanel Width="80" Margin="0,0,10,8"><TextBlock Text="PIS %"/><TextBox x:Name="TxtPisAliq" Style="{StaticResource ModernTextBox}" Text="0" TextChanged="CalcTotais"/></StackPanel>
                                <StackPanel Width="90" Margin="0,0,10,8"><TextBlock Text="COFINS CST"/><TextBox x:Name="TxtCofinsCst" Style="{StaticResource ModernTextBox}" Text="01"/></StackPanel>
                                <StackPanel Width="90" Margin="0,0,10,8"><TextBlock Text="COFINS %"/><TextBox x:Name="TxtCofinsAliq" Style="{StaticResource ModernTextBox}" Text="0" TextChanged="CalcTotais"/></StackPanel>
                                <StackPanel Width="120" Margin="0,0,10,8"><TextBlock Text="Forma pag."/><ComboBox x:Name="CbFormaPag" SelectedIndex="0"><ComboBoxItem Content="01-Dinheiro" Tag="01"/><ComboBoxItem Content="03-Cartão crédito" Tag="03"/><ComboBoxItem Content="04-Cartão débito" Tag="04"/><ComboBoxItem Content="17-Pix" Tag="17"/><ComboBoxItem Content="15-Boleto" Tag="15"/></ComboBox></StackPanel>
                                <StackPanel Width="400" Margin="0,0,10,8"><TextBlock Text="Informações complementares"/><TextBox x:Name="TxtInfCpl" Style="{StaticResource ModernTextBox}"/></StackPanel>
                                <StackPanel Width="140" Margin="0,0,10,8"><TextBlock Text="Total da nota"/><TextBox x:Name="TxtTotalNf" Style="{StaticResource ModernTextBox}" IsReadOnly="True" FontWeight="Bold"/></StackPanel>
                            </WrapPanel>

                            <TextBlock Text="IBS / CBS (reforma tributária)" FontWeight="Bold" Foreground="{DynamicResource TitleBrush}" Margin="0,10,0,4"/>
                            <TextBlock x:Name="LblNfIbsCbsInfo" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <WrapPanel>
                                <StackPanel Width="100" Margin="0,0,10,8"><TextBlock Text="CST IBS/CBS"/><TextBox x:Name="TxtCstIbsCbs" Style="{StaticResource ModernTextBox}" Text="000"/></StackPanel>
                                <StackPanel Width="120" Margin="0,0,10,8"><TextBlock Text="cClassTrib"/><TextBox x:Name="TxtClassTrib" Style="{StaticResource ModernTextBox}" Text="000001"/></StackPanel>
                                <StackPanel Width="90" Margin="0,0,10,8"><TextBlock Text="CBS %"/><TextBox x:Name="TxtCbsAliqNf" Style="{StaticResource ModernTextBox}" TextChanged="CalcTotais"/></StackPanel>
                                <StackPanel Width="100" Margin="0,0,10,8"><TextBlock Text="CBS R$"/><TextBox x:Name="TxtCbsValor" Style="{StaticResource ModernTextBox}" IsReadOnly="True"/></StackPanel>
                                <StackPanel Width="90" Margin="0,0,10,8"><TextBlock Text="IBS %"/><TextBox x:Name="TxtIbsAliqNf" Style="{StaticResource ModernTextBox}" TextChanged="CalcTotais"/></StackPanel>
                                <StackPanel Width="100" Margin="0,0,10,8"><TextBlock Text="IBS R$"/><TextBox x:Name="TxtIbsValor" Style="{StaticResource ModernTextBox}" IsReadOnly="True"/></StackPanel>
                                <StackPanel Width="100" Margin="0,0,10,8"><TextBlock Text="IBS UF R$"/><TextBox x:Name="TxtIbsUfValor" Style="{StaticResource ModernTextBox}" IsReadOnly="True"/></StackPanel>
                                <StackPanel Width="110" Margin="0,0,10,8"><TextBlock Text="IBS Mun R$"/><TextBox x:Name="TxtIbsMunValor" Style="{StaticResource ModernTextBox}" IsReadOnly="True"/></StackPanel>
                                <StackPanel Width="160" Margin="0,0,10,8" VerticalAlignment="Bottom">
                                    <CheckBox x:Name="ChkAutoIbsCbs" Content="Cálculo automático" IsChecked="True" Click="ChkAutoIbsCbs_Click"/>
                                </StackPanel>
                            </WrapPanel>

                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Integração com a API Fiscal (emissão real)" FontWeight="Bold" Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,8"/>
                                    <WrapPanel Margin="0,0,0,8">
                                        <StackPanel Width="300" Margin="0,0,10,8"><TextBlock Text="Chave de acesso"/><TextBox x:Name="TxtChaveAcesso" Style="{StaticResource ModernTextBox}" IsReadOnly="True"/></StackPanel>
                                        <StackPanel Width="140" Margin="0,0,10,8"><TextBlock Text="Protocolo"/><TextBox x:Name="TxtNProt" Style="{StaticResource ModernTextBox}" IsReadOnly="True"/></StackPanel>
                                        <StackPanel Width="380" Margin="0,0,10,8"><TextBlock Text="Situação na SEFAZ"/><TextBox x:Name="TxtStatusFiscal" Style="{StaticResource ModernTextBox}" IsReadOnly="True"/></StackPanel>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <Button x:Name="BtnEmitirApi" Content="🚀 EMITIR NA SEFAZ (API)" Style="{StaticResource HoverButtonStyle}" Padding="12,6" Margin="0,0,8,8" Click="BtnEmitirApi_Click"/>
                                        <Button x:Name="BtnConsultarStatus" Content="📊 Consultar status" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,8,8" Click="BtnConsultarStatus_Click"/>
                                        <Button x:Name="BtnBaixarXml" Content="⬇️ Baixar XML" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,8,8" Click="BtnBaixarXml_Click"/>
                                        <Button x:Name="BtnVerXml" Content="👁️ Ver XML" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,8,8" Click="BtnVerXml_Click"/>
                                        <Button x:Name="BtnBaixarDanfe" Content="🖨️ Baixar DANFE" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,8,8" Click="BtnBaixarDanfe_Click"/>
                                        <Button x:Name="BtnImprimirTermica" Content="🧾 Imprimir na térmica (NFC-e)" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,8,8" Click="BtnImprimirTermica_Click"
                                                ToolTip="Imprime a DANFE simplificada da NFC-e na impressora térmica configurada na tela de módulos"/>
                                        <Button x:Name="BtnCartaCorrecao" Content="✍️ Carta de Correção" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,8,8" Click="BtnCartaCorrecao_Click"/>
                                        <Button x:Name="BtnCancelarNota" Content="🛑 Cancelar nota" Background="{DynamicResource ActionDelBg}" Foreground="{DynamicResource ActionDelFg}"
                                                BorderThickness="0" Padding="10,5" Margin="0,0,8,8" Click="BtnCancelarNota_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="BtnExcluirForm" Content="🗑️ EXCLUIR" Background="{DynamicResource ActionDelBg}" Foreground="{DynamicResource ActionDelFg}"
                                BorderThickness="0" Margin="0,0,8,0" Padding="12,6" Click="BtnExcluirForm_Click" Visibility="Collapsed"/>
                        <Button Content="Cancelar" Margin="0,0,8,0" Padding="12,6" Click="BtnFecharForm_Click"
                                Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                        <Button Content="📄 GERAR XML" Style="{StaticResource HoverButtonStyle}" Click="BtnGerarXml_Click" Width="130" Margin="0,0,8,0"/>
                        <Button Content="💾 SALVAR" Style="{StaticResource HoverButtonStyle}" Click="BtnSalvar_Click" Width="120"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
