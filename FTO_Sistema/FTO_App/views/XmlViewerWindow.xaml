<Window x:Class="FTO_App.Views.XmlViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visualizar XML" Height="620" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CardBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="LblTitulo" Text="👁 XML da nota fiscal" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,10"/>

        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3">
            <TextBox x:Name="TxtXml" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12" Background="{DynamicResource InputBackgroundBrush}"
                     Foreground="{DynamicResource InputTextBrush}" BorderThickness="0" Padding="8"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="📋 Copiar" Padding="12,6" Margin="0,0,8,0" Click="BtnCopiar_Click"
                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
            <Button Content="💾 Salvar como..." Padding="12,6" Margin="0,0,8,0" Click="BtnSalvar_Click"
                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
            <Button Content="Fechar" Style="{StaticResource HoverButtonStyle}" Padding="12,6" Click="BtnFechar_Click"/>
        </StackPanel>
    </Grid>
</Window>
