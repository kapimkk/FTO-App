<Window x:Class="FTO_App.Views.ProdutoEstoquePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selecionar produto do estoque"
        Height="480" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button Content="Buscar" DockPanel.Dock="Right" Width="90" Margin="8,0,0,0"
                    Style="{StaticResource ToolbarButtonStyle}" Click="BtnBuscar_Click"/>
            <TextBox x:Name="TxtBusca" Style="{StaticResource ModernTextBox}"
                     ToolTip="Nome, código de barras ou categoria"
                     KeyDown="TxtBusca_KeyDown"/>
        </DockPanel>

        <DataGrid x:Name="GridProdutos" Grid.Row="1"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" HeadersVisibility="Column"
                  MouseDoubleClick="Grid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding CodigoBarras}" Width="120"/>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                <DataGridTextColumn Header="NCM" Binding="{Binding NcmExibicao}" Width="90"/>
                <DataGridTextColumn Header="CFOP" Binding="{Binding Cfop}" Width="70"/>
                <DataGridTextColumn Header="Estoque" Binding="{Binding Quantidade}" Width="70"/>
                <DataGridTextColumn Header="Preço" Binding="{Binding PrecoFormatado}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" Padding="14,6" Margin="0,0,8,0" Click="BtnCancelar_Click"
                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
            <Button Content="Usar este produto" Style="{StaticResource HoverButtonStyle}"
                    Padding="14,6" Click="BtnUsar_Click"/>
        </StackPanel>
    </Grid>
</Window>
